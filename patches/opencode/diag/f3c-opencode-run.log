import colorsys

def rgb(h):
    h=h.lstrip('#'); return tuple(int(h[i:i+2],16) for i in (0,2,4))
def hexs(c): return '#%02X%02X%02X' % tuple(round(v) for v in c)
def blend(fg_rgba, hexbg):
    r,g,b,a=fg_rgba; br,bg_,bb=rgb(hexbg)
    return tuple(round(c*a+back*(1-a)) for c,back in ((r,br),(g,bg_),(b,bb)))
def lum(color):
    def ch(v):
        c=v/255; return c/12.92 if c<=0.03928 else ((c+0.055)/1.055)**2.4
    r,g,b=(ch(v) for v in color); return 0.2126*r+0.7152*g+0.0722*b
def ratio(a,b):
    la,lb=lum(a),lum(b); hi,lo=max(la,lb),min(la,lb); return (hi+0.05)/(lo+0.05)

BG='#EEF2F4'; PANEL='#FFFFFF'; PANEL2='#F5F8F9'
def darker(start, targets, floor=4.55):
    r,g,b=[v/255 for v in rgb(start)]
    h,l,s=colorsys.rgb_to_hls(r,g,b)
    step=1.0
    while step>0:
        cand=colorsys.hls_to_rgb(h, l*step, s)
        c=tuple(round(v*255) for v in cand)
        if all(ratio(c, t) >= floor for t in targets):
            return hexs(c), step
        step-=0.005
    return None, None

signal_soft=(11,131,120,0.10)
amber_soft=(163,98,11,0.10)
sig_targets=[rgb(BG), rgb(PANEL2), rgb(PANEL2)]
sig, step = darker('#0B8378', [rgb(BG), rgb(PANEL2), blend(signal_soft, PANEL)], floor=4.6)
amb, step2 = darker('#A3620B', [blend(amber_soft, PANEL), rgb(PANEL), rgb(PANEL2)], floor=4.6)
print('signal light ->', sig, 'scale', round(step,3))
print('amber  light ->', amb, 'scale', round(step2,3))
for label, c, bg in [('signal/bg',sig,BG),('signal/panel2',sig,PANEL2),('signal/panel',sig,PANEL),
                     ('cite on signal-soft',sig,hexs(blend(signal_soft,PANEL))),
                     ('button label',BG,sig),
                     ('amber on amber-soft',amb,hexs(blend(amber_soft,PANEL))),
                     ('amber/panel',amb,PANEL),('amber/panel2',amb,PANEL2)]:
    print(f'{label:<24} {c} on {bg if isinstance(bg,str) else hexs(bg)}  {ratio(rgb(c),rgb(bg) if isinstance(bg,str) else bg):.2f}')
