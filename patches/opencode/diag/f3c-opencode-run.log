const { chromium } = require('/home/capw/tmp/playwright-check/node_modules/playwright');
const QUOTE = 'When this option is used, PostgreSQL will build the index without taking any locks that prevent concurrent inserts, updates, or deletes on the table';
const staged = {abstain:false, sentences:[
  {text:'CREATE INDEX CONCURRENTLY builds the index without blocking writes on the table.', citations:[{n:1,quote:QUOTE}]},
  {text:'BRIN is a small index that suits very large, naturally ordered tables.', citations:[{n:4,quote:QUOTE},{n:1,quote:QUOTE}]}],
  sources:[{n:1,url:'https://www.postgresql.org/docs/17/sql-createindex.html#SQL-CREATEINDEX-CONCURRENTLY',title:'CREATE INDEX'},
           {n:4,url:'https://www.postgresql.org/docs/17/brin.html#BRIN-INTRO',title:'11.4. BRIN Indexes'}]};
(async () => {
  const browser = await chromium.launch();
  const ctx = await browser.newContext({viewport:{width:1366,height:900}, colorScheme:'dark'});
  await ctx.route('**/api/ask', r => r.fulfill({status:200, contentType:'application/json', body: JSON.stringify(staged)}));
  const page = await ctx.newPage();
  await page.setViewportSize({width:360,height:780});
  await page.goto('http://127.0.0.1:8792/?lang=en', {waitUntil:'networkidle'});
  await page.fill('#question','How do I build an index without blocking writes on the table?');
  await page.press('#question','Enter');
  await page.waitForSelector('#result .card');
  await page.waitForTimeout(500);
  const before = await page.evaluate(() => document.documentElement.scrollWidth);
  const wide = await page.evaluate(() => Array.from(document.querySelectorAll('*')).filter(n => n.getBoundingClientRect().right > window.innerWidth + 1).map(n => ({tag:n.tagName, cls:n.className, right:Math.round(n.getBoundingClientRect().right), w:Math.round(n.getBoundingClientRect().width)})).slice(0,12));
  console.log('scrollWidth before popover:', before, 'innerWidth', await page.evaluate(()=>window.innerWidth));
  console.log(JSON.stringify(wide, null, 1));
  const cites = await page.$$('#result .cite');
  await cites[cites.length-1].click();
  await page.waitForTimeout(200);
  const after = await page.evaluate(() => document.documentElement.scrollWidth);
  const wide2 = await page.evaluate(() => Array.from(document.querySelectorAll('*')).filter(n => n.getBoundingClientRect().right > window.innerWidth + 1).map(n => ({tag:n.tagName, cls:n.className, right:Math.round(n.getBoundingClientRect().right), w:Math.round(n.getBoundingClientRect().width)})).slice(0,12));
  console.log('scrollWidth after popover:', after);
  console.log(JSON.stringify(wide2, null, 1));
  await browser.close();
})();
EOF
