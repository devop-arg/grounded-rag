"""WCAG 2.1 contrast ratios for the pairs actually used in web/app.css."""
from itertools import count

def rgb(hexcode):
    h = hexcode.lstrip('#')
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def blend(fg_rgba, hexbg):
    r, g, b, a = fg_rgba
    br, bg_, bb = rgb(hexbg)
    return tuple(round(c * a + back * (1 - a)) for c, back in ((r, br), (g, bg_), (b, bb)))

def luminance(color):
    def channel(value):
        c = value / 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (channel(v) for v in color)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def ratio(a, b):
    la, lb = luminance(a), luminance(b)
    high, low = max(la, lb), min(la, lb)
    return (high + 0.05) / (low + 0.05)

THEMES = {
    'dark': {
        'bg': '#0A1219', 'panel': '#0F1A23', 'panel-2': '#13212C', 'line': '#1F3240',
        'fg': '#DCE7EE', 'muted': '#8DA1B0', 'signal': '#4FD1C5', 'amber': '#F2B04A',
    },
    'light': {
        'bg': '#EEF2F4', 'panel': '#FFFFFF', 'panel-2': '#F5F8F9', 'line': '#D3DDE3',
        'fg': '#0E1B24', 'muted': '#526471', 'signal': '#0B8378', 'amber': '#A3620B',
    },
}
SOFT = {
    'dark': {'signal-soft': (79, 209, 197, 0.12), 'amber-soft': (242, 176, 74, 0.13)},
    'light': {'signal-soft': (11, 131, 120, 0.10), 'amber-soft': (163, 98, 11, 0.10)},
}

failures = 0
for name, tokens in THEMES.items():
    soft = SOFT[name]
    cite_bg = blend(soft['signal-soft'], tokens['panel'])
    badge_bg = blend(soft['amber-soft'], tokens['panel'])
    pairs = [
        ('body text', tokens['fg'], rgb(tokens['bg'])),
        ('card text', tokens['fg'], rgb(tokens['panel'])),
        ('card-2 text', tokens['fg'], rgb(tokens['panel-2'])),
        ('muted on page', tokens['muted'], rgb(tokens['bg'])),
        ('muted on card', tokens['muted'], rgb(tokens['panel'])),
        ('muted on card-2', tokens['muted'], rgb(tokens['panel-2'])),
        ('signal link on card', tokens['signal'], rgb(tokens['panel'])),
        ('signal link on page', tokens['signal'], rgb(tokens['bg'])),
        ('cite text on signal-soft', tokens['signal'], cite_bg),
        ('button label (bg on signal)', tokens['bg'], rgb(tokens['signal'])),
        ('amber badge on amber-soft', tokens['amber'], badge_bg),
        ('amber border/text on card', tokens['amber'], rgb(tokens['panel'])),
        ('popover quote', tokens['fg'], rgb(tokens['panel-2'])),
        ('popover link', tokens['signal'], rgb(tokens['panel-2'])),
    ]
    print(f'theme: {name}')
    print(f'  {"pair":<32} {"fg":<9} {"bg":<12} {"ratio":>6}  AA-4.5  AA-3.0')
    print('  ' + '-' * 78)
    for label, fg, bg_ in pairs:
        value = ratio(rgb(fg) if isinstance(fg, str) else fg, rgb(bg_) if isinstance(bg_, str) else bg_)
        ok_normal = value >= 4.5
        ok_large = value >= 3.0
        if not ok_normal:
            failures += 1
        print(f'  {label:<32} {fg if isinstance(fg, str) else "blend":<9} '
              f'{bg_ if isinstance(bg_, str) else "blend":<12} {value:>6.2f}  '
              f'{"PASS" if ok_normal else "FAIL":<7} {"PASS" if ok_large else "FAIL"}')
    print()

print(f'summary: {failures} pair(s) below AA 4.5 for normal text')
