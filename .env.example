# grounded-rag settings. Copy to .env.local at the root of the repository
# (ignored by git) or to ~/.config/grounded-rag/env (chmod 600) and fill in what
# you need. The real environment wins over .env.local, which wins over the user
# file. An empty value means "not set": the defaults of the code apply, and
# nothing is hardcoded, so the endpoint, the model and the key below are the
# only way to reach a model.
GROUNDED_RAG_LLM_BASE_URL=
GROUNDED_RAG_LLM_MODEL=
GROUNDED_RAG_LLM_API_KEY=
# Alternative to GROUNDED_RAG_LLM_API_KEY: a JSON file and the dotted path of
# the key inside it (for example "llm.key"). The key is read when the client is
# built, never stored in the config and never printed. A non-empty
# GROUNDED_RAG_LLM_API_KEY wins. Both variables are needed.
GROUNDED_RAG_LLM_KEY_FILE=
GROUNDED_RAG_LLM_KEY_PATH=
# Optional attribution headers: left out of the request when empty.
GROUNDED_RAG_LLM_REFERER=
GROUNDED_RAG_LLM_TITLE=
# USD per million tokens, used to price every answer (0 = a free endpoint).
GROUNDED_RAG_LLM_PRICE_INPUT_PER_M=
GROUNDED_RAG_LLM_PRICE_OUTPUT_PER_M=
# USD allowed per UTC month, accumulated in data/usage.sqlite (default 0.50).
GROUNDED_RAG_BUDGET_USD_PER_MONTH=
GROUNDED_RAG_GENERATION=
# Optional remote retrieval parts. Each one is off while its model is empty, and
# they share GROUNDED_RAG_LLM_BASE_URL and the key above. Every remote failure
# falls back to the local path for that part; nothing fails because of it.
# Rerank the top candidates of the hybrid search before grouping by page.
GROUNDED_RAG_RERANK_MODEL=
# Embed the query remotely from a named vector index built with
# `python -m retrieval.reindex --index <name>` (the local vectors.npy is never
# touched). The index name defaults to a slug of the model.
GROUNDED_RAG_EMBED_MODEL=
GROUNDED_RAG_EMBED_INDEX=
# Output dimensions, only when the index was built with `reindex --dims N`.
GROUNDED_RAG_EMBED_DIMS=
# Translate a non-English question to English for the lexical search only.
GROUNDED_RAG_TRANSLATE_MODEL=
# Prices used when the endpoint does not report a cost (0 = free endpoint).
GROUNDED_RAG_EMBED_PRICE_PER_M=
GROUNDED_RAG_RERANK_PRICE_PER_SEARCH=
GROUNDED_RAG_TRANSLATE_PRICE_INPUT_PER_M=
GROUNDED_RAG_TRANSLATE_PRICE_OUTPUT_PER_M=
# Sliding-window limit per IP and the salt of the IP hashes. An empty salt means
# a random per-process one (the digests are then not comparable across
# restarts); it is never printed or logged.
GROUNDED_RAG_RATE_PER_IP=
GROUNDED_RAG_IP_SALT=
GROUNDED_RAG_PORT=
