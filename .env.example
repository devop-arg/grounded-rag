# Copy to ~/.config/grounded-rag/env (chmod 600) and fill in the values.
# Variables set in the real environment win over this file.
GROUNDED_RAG_LLM_BASE_URL=
GROUNDED_RAG_LLM_API_KEY=
GROUNDED_RAG_LLM_MODEL=
GROUNDED_RAG_GENERATION=on
# Sólo fecha y tokens en data/usage.sqlite; límite por IP con ventana deslizante.
GROUNDED_RAG_DAILY_TOKEN_CAP=200000
GROUNDED_RAG_RATE_PER_IP=10/hour
# Sal de los hashes de IP. Si queda vacía se usa una sal aleatoria por proceso
# (los digests no son comparables entre reinicios); no se imprime ni se loguea.
GROUNDED_RAG_IP_SALT=
GROUNDED_RAG_PORT=8790
