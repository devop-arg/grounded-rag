# grounded-rag settings. Copy to ~/.config/grounded-rag/env (chmod 600) and
# fill in what you need. Variables set in the real environment win over this
# file. An empty value means "not set": the defaults of the code apply, and
# nothing is hardcoded, so the endpoint, the model and the key below are the
# only way to reach a model.
GROUNDED_RAG_LLM_BASE_URL=
GROUNDED_RAG_LLM_MODEL=
GROUNDED_RAG_LLM_API_KEY=
# Alternative to GROUNDED_RAG_LLM_API_KEY: a JSON file and the dotted path of
# the key inside it (for example "llm.key"). The key is read when the client is
# built, never stored in the config and never printed. A non-empty
# GROUNDED_RAG_LLM_API_KEY wins. Both variables are needed.
GROUNDED_RAG_LLM_KEY_FILE=
GROUNDED_RAG_LLM_KEY_PATH=
# Optional attribution headers: left out of the request when empty.
GROUNDED_RAG_LLM_REFERER=
GROUNDED_RAG_LLM_TITLE=
# USD per million tokens, used to price every answer (0 = a free endpoint).
GROUNDED_RAG_LLM_PRICE_INPUT_PER_M=
GROUNDED_RAG_LLM_PRICE_OUTPUT_PER_M=
# USD allowed per UTC month, accumulated in data/usage.sqlite (default 0.50).
GROUNDED_RAG_BUDGET_USD_PER_MONTH=
GROUNDED_RAG_GENERATION=
# Sliding-window limit per IP and the salt of the IP hashes. An empty salt means
# a random per-process one (the digests are then not comparable across
# restarts); it is never printed or logged.
GROUNDED_RAG_RATE_PER_IP=
GROUNDED_RAG_IP_SALT=
GROUNDED_RAG_PORT=
